{
  "name": "alatau-service-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5173",
    "build": "next build",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "preview": "npm run build && npm run prepare:standalone && node .next/standalone/server.js",
    "preview:supabase": "node scripts/start-supabase-preview.mjs",
    "runtime:acceptance": "node scripts/runtime-acceptance.mjs",
    "supabase:cutover-local": "node scripts/cutover-local-supabase.mjs",
    "supabase:migrate": "node scripts/apply-supabase-migrations.mjs",
    "supabase:env-status": "node scripts/supabase-env-status.mjs",
    "supabase:readiness": "node scripts/supabase-readiness.mjs",
    "postgres:preflight": "node scripts/postgres-runtime-preflight.mjs",
    "supabase:preflight": "node scripts/supabase-runtime-preflight.mjs",
    "start": "next start -p ${PORT:-5173}",
    "lint": "tsc --noEmit --project tsconfig.lint.json",
    "test": "node scripts/test-runner.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8",
    "next": "^16.2.9",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.67"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@types/node": "^24.0.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
