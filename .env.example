# Public Supabase browser/client settings
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=EXAMPLE_PUBLIC_ANON_KEY

# Server-only Supabase service role key. Keep only in the runtime secret store.
SUPABASE_SERVICE_ROLE_KEY=EXAMPLE_SERVICE_ROLE_KEY

# Comma-separated admin emails allowed to enter /admin.
ADMIN_EMAILS=owner@example.com

# Public URL used for magic-link redirects and release metadata.
NEXT_PUBLIC_SITE_URL=https://alatau-service.com

# Local/mock mode is useful before managed Supabase credentials are connected.
# Use postgres for direct Supabase Postgres writes via SUPABASE_DB_URL.
# Use supabase for Supabase REST/Auth through URL + anon + service role keys.
DATA_BACKEND=memory

# Optional: used by ops scripts when a direct SQL migration channel is available.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:REDACTED@aws-0-region.pooler.supabase.com:6543/postgres

# Disabled by default. Use runtime secret injection for a real token.
TELEGRAM_NOTIFICATIONS=disabled
TELEGRAM_BOT_TOKEN=EXAMPLE_TOKEN
TELEGRAM_CHAT_ID=EXAMPLE_CHAT_ID

# Release metadata, normally injected by deploy scripts.
APP_RELEASE_ID=local-dev
APP_RELEASE_SHA=unknown
