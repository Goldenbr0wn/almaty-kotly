# Copy this file outside the repo, fill it from the Supabase dashboard or secret manager,
# then pass it with: --env-file /absolute/path/to/alatau-supabase.env
#
# Do not commit the filled env file.

# Runtime mode:
# - postgres: direct writes through SUPABASE_DB_URL
# - supabase: REST/Auth through URL + anon + service role keys
DATA_BACKEND=postgres

# Public site URL used for redirects and release metadata.
NEXT_PUBLIC_SITE_URL=https://alatau-service.com

# Comma-separated admin emails allowed to enter /admin, /crm, and /profile.
ADMIN_EMAILS=owner@example.com

# Supabase project URL and keys.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=EXAMPLE_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=EXAMPLE_SERVICE_ROLE_KEY

# Direct SQL channel for migrations and DATA_BACKEND=postgres.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:REDACTED@aws-0-region.pooler.supabase.com:6543/postgres

# Optional release metadata.
APP_RELEASE_ID=alatau-local-supabase
APP_RELEASE_SHA=unknown

# Optional Telegram notifications. Keep disabled until the real bot/chat is approved.
TELEGRAM_NOTIFICATIONS=disabled
TELEGRAM_BOT_TOKEN=EXAMPLE_TOKEN
TELEGRAM_CHAT_ID=EXAMPLE_CHAT_ID
